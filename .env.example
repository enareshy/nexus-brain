# Copy to .env (gitignored). Never commit real values.

NODE_ENV=development
LOG_LEVEL=debug

# Postgres (pgvector image)
DATABASE_URL=postgres://brain:brain@localhost:5432/brain
DATABASE_APP_ROLE_URL=postgres://brain_app:brain_app@localhost:5432/brain

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_ALIAS=chunks

# Kafka-compatible (Redpanda)
KAFKA_BROKERS=localhost:19092

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=brain-raw
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# API
API_HOST=127.0.0.1
API_PORT=3001
# OAuth redirect URI = PUBLIC_API_URL/oauth/callback
PUBLIC_API_URL=http://127.0.0.1:3001
# CORS allow-list and post-connect redirect
WEB_APP_URL=http://localhost:3000
# Comma-separated MCP server allow-list (FR-MCP-02)
MCP_SERVERS=atlassian,github,google-drive,gmail,slack,notion
# Optional. Normally an admin sets these up on the Connections page, per company.
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=
GOOGLE_MCP_CLIENT_ID=
GOOGLE_MCP_CLIENT_SECRET=

# OIDC (Keycloak local)
OIDC_ISSUER=http://localhost:8081/realms/brain
OIDC_AUDIENCE=brain-api
MCP_SERVER_AUDIENCE=brain-mcp
OIDC_CLIENT_ID=brain-web

# LLM vendors (fill in; keep out of git). Without ANTHROPIC_API_KEY, search still works
# and "Answer with AI" reports that answers are not configured.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# Embeddings
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIM=1024

# Connectors (OAuth apps you create)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
CONNECTOR_TOKEN_ENC_KEY=   # 32-byte base64; generate with: openssl rand -base64 32

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Limits
AGENT_MAX_STEPS=25
AGENT_MAX_COST_USD=0.50
