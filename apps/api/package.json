{
  "name": "@brain/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts --coverage",
    "ranker:train": "node --env-file-if-exists=../../.env --import tsx scripts/train-rankers.ts"
  },
  "dependencies": {
    "@brain/connectors": "workspace:*",
    "@brain/core": "workspace:*",
    "@brain/db": "workspace:*",
    "@brain/llm-gateway": "workspace:*",
    "@brain/mcp-client": "workspace:*",
    "@brain/telemetry": "workspace:*",
    "@fastify/rate-limit": "^10.2.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@brain/evals": "workspace:*",
    "@nestjs/testing": "^11.0.0",
    "pg": "^8.13.1",
    "@types/pg": "^8.11.10"
  }
}
