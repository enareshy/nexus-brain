    "@nestjs/platform-fastify": "^11.0.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
