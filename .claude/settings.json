{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test*)",
      "Bash(pnpm eval*)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm dev)",
      "Bash(pnpm infra:up)",
      "Bash(pnpm infra:down)",
      "Bash(pnpm secrets:scan)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(docker compose down -v*)",
      "Bash(curl*|*sh)"
    ]
  },
  "env": {
    "NODE_ENV": "development"
  }
}
