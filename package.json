{
  "name": "nexus-brain",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@brain/api --filter=@brain/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "test:cov": "turbo run test:cov",
    "test:leak": "pnpm --filter @brain/db test:int && pnpm --filter @brain/api exec vitest run --config vitest.int.config.ts src/leak.int.test.ts src/graph/graph.int.test.ts src/ranking/ranker.int.test.ts",
    "eval": "pnpm --filter @brain/evals eval",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @brain/db migrate",
    "db:seed": "pnpm --filter @brain/db seed",
    "secrets:scan": "node scripts/secrets-scan.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.5"
  }
}
