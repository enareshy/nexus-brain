{
  "name": "@brain/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed-data": "./src/seed-data.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/cli/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/cli/seed.ts"
  },
  "dependencies": {
    "@brain/core": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
